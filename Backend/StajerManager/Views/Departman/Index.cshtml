@model IEnumerable<StajerManager.Models.DepartmanModel>

@{
    ViewData["Title"] = "Departmanlar";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">
                <i class="fas fa-building text-primary me-2"></i>
                DEPARTMANLAR
            </h1>
        </div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="row mb-3">
            <div class="col-12">
                <a onclick="showPopup('@Url.Action("Create", "Departman")', 'Yeni Departman Ekle')" href="javascript:void(0)" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Yeni Departman Ekle
                </a>
            </div>
        </div>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="departmanTable">
        <thead class="table-dark">
            <tr>
                <th>
                    <i class="fas fa-building me-1"></i>@Html.DisplayNameFor(model => model.DepartmanAdi)
                </th>
                <th>
                    <i class="fas fa-info-circle me-1"></i>@Html.DisplayNameFor(model => model.Aciklama)
                </th>
                @* <th>
                    <i class="fas fa-users me-1"></i>Stajer Sayısı
                </th> *@
                <th class="text-center">
                    <i class="fas fa-cogs me-1"></i>İşlemler
                </th>
            </tr>
        </thead>
        <tbody id="departmanTableBody">
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.DepartmanAdi)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Aciklama)
                    </td>
                    @* <td>
                        <span class="badge bg-info">@item.Stajers.Count</span>
                    </td> *@    
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a onclick="showPopup('@Url.Action("Details", "Departman")/@item.DepartmanID', 'Departman Detayları')" href="javascript:void(0)" class="btn btn-info btn-sm" title="Detaylar">
                                <i class="fas fa-eye"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a onclick="showPopup('@Url.Action("Edit", "Departman")/@item.DepartmanID', 'Departman Düzenle')" href="javascript:void(0)" class="btn btn-warning btn-sm" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a onclick="showPopup('@Url.Action("Delete", "Departman")/@item.DepartmanID', 'Departman Sil')" href="javascript:void(0)" class="btn btn-danger btn-sm" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="form-modal" tabindex="-1" aria-labelledby="form-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="form-modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>
