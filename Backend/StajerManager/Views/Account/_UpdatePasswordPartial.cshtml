@model ChangePasswordViewModel

<div class="modal-header px-4 py-3">
    <h5 class="modal-title">
        <i class="fas fa-key me-2"></i>Şifre Değiştir
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body px-4 py-4">
    <div class="alert alert-info mb-4">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Şifre değiştirme</strong><br>
        Güvenliğiniz için mevcut şifrenizi girin ve yeni şifre belirleyin.
    </div>

    <form id="changePasswordForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert" style="display: none;" id="validationSummary">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Hata!</strong>
            <ul class="mb-0 mt-2" id="validationErrors"></ul>
        </div>

        <div class="mb-4">
            <label asp-for="CurrentPassword" class="form-label">
                <i class="fas fa-lock me-1"></i>@Html.DisplayNameFor(m => m.CurrentPassword)
            </label>
            <input asp-for="CurrentPassword" class="form-control" placeholder="Mevcut şifrenizi giriniz" />
            <span asp-validation-for="CurrentPassword" class="text-danger fw-bold"></span>
        </div>

        <div class="mb-4">
            <label asp-for="NewPassword" class="form-label">
                <i class="fas fa-key me-1"></i>@Html.DisplayNameFor(m => m.NewPassword)
            </label>
            <input asp-for="NewPassword" class="form-control" placeholder="Yeni şifrenizi giriniz" />
            <span asp-validation-for="NewPassword" class="text-danger fw-bold"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label">
                <i class="fas fa-key me-1"></i>@Html.DisplayNameFor(m => m.ConfirmNewPassword)
            </label>
            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Yeni şifrenizi tekrar giriniz" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger fw-bold"></span>
        </div>
    </form>
</div>



<div class="modal-footer px-4 py-3">
@*     <button type="button" class="btn btn-danger" id="deleteAccountBtn">
        <i class="fas fa-suitcase me-1"></i>Hesabı Sil
    </button> *@

    <a onclick="showPopup('@Url.Action("DeleteAccount", "Account")', 'Hoş geldin')" href="javascript:void(0)" class="btn btn-danger">
        <i class="fas fa-suitcase me-1"></i>Hesabı Sil, @User.Identity.Name
    </a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i>İptal
    </button>
    <button type="button" id="changePasswordBtn" class="btn btn-primary">
        <i class="fas fa-save me-1"></i>Şifremi Değiştir
    </button>
</div>

<script>
$(document).ready(function() {


    // Form validasyonu için
    function validateForm() {
        var isValid = true;
        var errors = [];
        
        // Mevcut şifre kontrolü
        var currentPassword = $('input[name="CurrentPassword"]').val().trim();
        if (!currentPassword) {
            errors.push('Mevcut şifre gereklidir.');
            isValid = false;
        }
        
        // Yeni şifre kontrolü
        var newPassword = $('input[name="NewPassword"]').val().trim();
        if (!newPassword) {
            errors.push('Yeni şifre gereklidir.');
            isValid = false;
        } else if (newPassword.length < 6) {
            errors.push('Yeni şifre en az 6 karakter olmalıdır.');
            isValid = false;
        }
        
        // Şifre onayı kontrolü
        var confirmPassword = $('input[name="ConfirmNewPassword"]').val().trim();
        if (!confirmPassword) {
            errors.push('Şifre onayı gereklidir.');
            isValid = false;
        } else if (newPassword !== confirmPassword) {
            errors.push('Yeni şifreler eşleşmiyor.');
            isValid = false;
        }
        
        // Hataları göster
        if (!isValid) {
            showValidationErrors(errors);
        } else {
            hideValidationErrors();
        }
        
        return isValid;
    }
    
    function showValidationErrors(errors) {
        var validationSummary = $('#validationSummary');
        var validationErrors = $('#validationErrors');
        
        validationErrors.empty();
        errors.forEach(function(error) {
            validationErrors.append('<li>' + error + '</li>');
        });
        
        validationSummary.show();
        validationSummary.addClass('alert-danger').removeClass('alert-info');
    }
    
    function hideValidationErrors() {
        $('#validationSummary').hide();
    }
    
    $('#changePasswordBtn').click(function() {
        // Önce form validasyonu yap
        if (!validateForm()) {
            return;
        }
        
        var form = $('#changePasswordForm');
        var formData = form.serialize();
        
        // Loading durumu
        var btn = $(this);
        var originalText = btn.html();
        btn.html('<i class="fas fa-spinner fa-spin me-1"></i>İşleniyor...').prop('disabled', true);
        
        $.ajax({
            url: '@Url.Action("UpdatePassword", "Account")',
            type: 'POST',
            data: formData,
            success: function(response) {
                if (response.success) {
                    hideValidationErrors();
                    showMessage(response.message, 'success');
                    $('#changePasswordModal').modal('hide');
                    form[0].reset();
                } else {
                    hideValidationErrors();
                    showMessage(response.message, 'error');
                }
            },
            error: function() {
                hideValidationErrors();
                showMessage('❌ <strong>Hata!</strong><br><br>Bir hata oluştu. Lütfen tekrar deneyin.', 'error');
            },
            complete: function() {
                // Loading durumunu kaldır
                btn.html(originalText).prop('disabled', false);
            }
        });
    });
    
    // Input değişikliklerinde hataları gizle
    $('#changePasswordForm input').on('input', function() {
        hideValidationErrors();
    });
});
</script>