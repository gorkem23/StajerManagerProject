@{
    ViewData["Title"] = "Şifre Sıfırlama Linki Gönderildi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="text-center mb-0">
                        <i class="fas fa-check-circle me-2"></i>Link Gönderildi
                    </h3>
                </div>
                <div class="card-body text-center">
                    <div class="alert alert-success">
                        <i class="fas fa-envelope-open-text me-2"></i>
                        <strong>Şifre sıfırlama linki gönderildi!</strong>
                    </div>
                    
                    <p class="mb-3">
                        E-posta adresinize şifre sıfırlama linki gönderilmiştir.
                        Lütfen e-postanızı kontrol edin ve linke tıklayın.
                    </p>
                    
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Önemli:</strong> E-posta gelmezse spam klasörünü kontrol edin.
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt me-1"></i>Giriş Sayfasına Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
