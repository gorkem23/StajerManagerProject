@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center mb-0">
                        <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                <i class="fas fa-envelope me-1"></i>@Html.DisplayNameFor(m => m.Email)
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="E-posta adresinizi giriniz" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-lock me-1"></i>@Html.DisplayNameFor(m => m.Password)
                            </label>
                            <input asp-for="Password" class="form-control" placeholder="Şifrenizi giriniz" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">
                                @Html.DisplayNameFor(m => m.RememberMe)
                            </label>
                        </div>


                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt me-1"></i>Giriş Yap
                            </button>
                        </div>

                        <div class="text-center mb-3">
                            <a asp-action="ForgotPassword" class="text-decoration-none">
                                <i class="fas fa-key me-1"></i>Şifremi Unuttum
                            </a>
                        </div>

                    </form>
                </div>
                <div class="card-footer text-center">
                    <p class="mb-0">
                        Hesabınız yok mu? 
                        <a asp-action="Register" class="text-decoration-none">
                            <i class="fas fa-user-plus me-1"></i>Kayıt Ol
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
