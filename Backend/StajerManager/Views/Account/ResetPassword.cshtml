@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center mb-0">
                        <i class="fas fa-lock me-2"></i>Yeni Şifre Belirle
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Yeni şifre</strong><br>
                        Lütfen yeni şifrenizi belirleyin.
                    </div>
                    
                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Token" type="hidden" />
                        
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-lock me-1"></i>@Html.DisplayNameFor(m => m.Password)
                            </label>
                            <input asp-for="Password" class="form-control" placeholder="Yeni şifrenizi giriniz" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="fas fa-lock me-1"></i>@Html.DisplayNameFor(m => m.ConfirmPassword)
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar giriniz" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Şifremi Sıfırla
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <p class="mb-0">
                        Şifrenizi hatırladınız mı? 
                        <a asp-action="Login" class="text-decoration-none">
                            <i class="fas fa-sign-in-alt me-1"></i>Giriş Yap
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}