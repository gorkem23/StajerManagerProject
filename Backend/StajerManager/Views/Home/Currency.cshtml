@{
    ViewData["Title"] = "Currency Page";
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   @*  <title>Kripto Para Tablosu</title>
    <link rel="stylesheet" href="zcoin.css"> *@
</head>
<body>
    <div class="container">
        <h1>Kripto Para Fiyatları</h1>

        <div class="table-responsive">
            <table class="crypto-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Coins</th>
                        <th>Coin Symbol</th>
                        <th>Price</th>
                        <th>24 Hour Change</th>
                        <th>Market Cap</th>
                    </tr>
                </thead>
                <tbody id="cryptoTableBody">
                    <!-- Satırlar JavaScript ile eklenecek -->
                </tbody>
            </table>
        </div>
        <div id="LastUpdated"></div>
    </div>
    <div class="modal fade" id="coinDetailModal" tabindex="-1" aria-labelledby="coinDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="coinDetailModalLabel">Coin Detayları</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="coinDetailContent">
                <!-- Coin bilgileri buraya gelecek -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
    <script src="zcoin.js"></script>
</body>
</html>


<script>
        //const LastUpdated = document.getElementById('LastUpdated')

    // CoinGecko API'den veri çekme fonksiyonu
    async function fetchCryptoData() {
        const response = await fetch('https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=50', {
            headers: {
                'x-cg-demo-api-key': 'CG-ZA8xCPnuujEn87TQjsv7boak'
            }
        });

        const data = await response.json();
        return data;
    }

    // API test fonksiyonu
    async function testAPI() {
        console.log('API testi başlatılıyor...');
        const data = await fetchCryptoData();

        if (data && data.length > 0) {
            console.log('✅ API çalışıyor! Veri geldi:', data.length, 'adet coin');
            data.forEach(coin => {
                console.log('Coin:', coin.name, '- Fiyat: $' + coin.current_price);
            });

            // LastUpdated div'ini güncelle
            const lastUpdated = data[0].last_updated;
            LastUpdated.innerHTML = `🕒 <span style="color: #4CAF50;">Son güncelleme:</span> ${new Date(lastUpdated).toLocaleString('tr-TR')}`;
        } else {
            console.log('❌ API hatası - veri gelmedi');
        }
    }

    // Sayfa yüklendiğinde test et
    testAPI();

    // Tüm coinleri tabloya ekleme fonksiyonu
    async function addAllCoinsToTable() {
        console.log('Tüm coinler tabloya ekleniyor...');
        const data = await fetchCryptoData();

        if (data && data.length > 0) {
            const tableBody = document.getElementById('cryptoTableBody');

            // Tabloyu temizle
            tableBody.innerHTML = '';

            // Her coin için satır oluştur
            data.forEach((coin, index) => {
                const row = document.createElement('tr');
                const changeClass = coin.price_change_percentage_24h >= 0 ? 'positive' : 'negative';

                row.innerHTML = `
                    <td colspan="6">
                    <button onclick="selectCoin(${index})" style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 10px;">
                        <span>${index + 1}</span>
                        <span class="coin-name">${coin.name}</span>
                        <span class="coin-symbol">${coin.symbol.toUpperCase()}</span>
                        <span class="price">$${coin.current_price ? coin.current_price.toLocaleString() : 'N/A'}</span>
                        <span class="${changeClass}">${coin.price_change_percentage_24h ? coin.price_change_percentage_24h.toFixed(2) : '0.00'}%</span>
                        <span class="market-cap">$${coin.market_cap ? (coin.market_cap / 1000000000).toFixed(1) + 'B' : 'N/A'}</span>
                    </button>
                </td>
                `;

                tableBody.appendChild(row);
            });

            console.log(`✅ ${data.length} adet coin tabloya eklendi!`);
        }
    }

    // Sayfa yüklendiğinde tüm coinleri ekle
    addAllCoinsToTable();

    // Otomatik güncelleme fonksiyonu
    async function autoUpdateTable() {
        try {
            console.log('🔄 Tabloyu güncelliyorum...');

            // API'den yeni veri çek
            const data = await fetchCryptoData();

            if (data && data.length > 0) {
                const tableBody = document.getElementById('cryptoTableBody');

                // Mevcut satırları güncelle (yeni satır ekleme, mevcut satırları güncelle)
                data.forEach((coin, index) => {
                    const existingRow = tableBody.children[index];

                    if (existingRow) {
                        // Mevcut satırı güncelle
                        const changeClass = coin.price_change_percentage_24h >= 0 ? 'positive' : 'negative';
                        existingRow.innerHTML = `
                            <td colspan="6">
                            <button onclick="selectCoin(${index})" style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 10px;">
                                <span>${index + 1}</span>
                                <span class="coin-name">${coin.name}</span>
                                <span class="coin-symbol">${coin.symbol.toUpperCase()}</span>
                                <span class="price">$${coin.current_price ? coin.current_price.toLocaleString() : 'N/A'}</span>
                                <span class="${changeClass}">${coin.price_change_percentage_24h ? coin.price_change_percentage_24h.toFixed(2) : '0.00'}%</span>
                                <span class="market-cap">$${coin.market_cap ? (coin.market_cap / 1000000000).toFixed(1) + 'B' : 'N/A'}</span>
                            </button>
                        </td>
                        `;
                    } else {
                        // Yeni satır ekle
                        const row = document.createElement('tr');
                        const changeClass = coin.price_change_percentage_24h >= 0 ? 'positive' : 'negative';

                        row.innerHTML = `
                            <td colspan="6">
                            <button onclick="selectCoin(${index})" style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 10px;">
                                <span>${index + 1}</span>
                                <span class="coin-name">${coin.name}</span>
                                <span class="coin-symbol">${coin.symbol.toUpperCase()}</span>
                                <span class="price">$${coin.current_price ? coin.current_price.toLocaleString() : 'N/A'}</span>
                                <span class="${changeClass}">${coin.price_change_percentage_24h ? coin.price_change_percentage_24h.toFixed(2) : '0.00'}%</span>
                                <span class="market-cap">$${coin.market_cap ? (coin.market_cap / 1000000000).toFixed(1) + 'B' : 'N/A'}</span>
                            </button>
                        </td>
                        `;

                        tableBody.appendChild(row);
                    }
                });

                // LastUpdated div'ini güncelle
                const LastUpdated = document.getElementById('LastUpdated');
                const lastUpdated = data[0].last_updated;
                LastUpdated.innerHTML = `🕒 <span style="color: #4CAF50;">Son güncelleme:</span> ${new Date(lastUpdated).toLocaleString('tr-TR')}`;

                console.log('✅ Tablo güncellendi!');
            }
        } catch (error) {
            console.error('❌ Güncelleme hatası:', error);
        }
    }

    // 3 saniyede bir çalıştır
    setInterval(autoUpdateTable, 3000);

    // Sayfa yüklendiğinde de bir kez çalıştır
    autoUpdateTable();

    // Coin seçme fonksiyonu - Modal açmak için
    function selectCoin(index) {
        console.log('Seçilen coin index:', index);
        
        // API'den coin verilerini al
        fetchCryptoData().then(data => {
            if (data && data[index]) {
                const coin = data[index];
                
                // Modal içeriğini oluştur
                const modalContent = `
                    <div class="coin-detail-header mb-4">
                        <div class="d-flex align-items-center">
                            <img src="${coin.image}" alt="${coin.name}" width="50" height="50" class="me-3">
                            <div>
                                <h3 class="mb-0">${coin.name}</h3>
                                <p class="text-muted mb-0">${coin.symbol.toUpperCase()}</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="info-card">
                                <h6>Fiyat Bilgileri</h6>
                                <p><strong>Mevcut Fiyat:</strong><br>$${coin.current_price.toLocaleString()}</p>
                                <p><strong>24h Değişim:</strong><br>
                                    <span class="${coin.price_change_percentage_24h >= 0 ? 'positive' : 'negative'}">
                                        ${coin.price_change_percentage_24h.toFixed(2)}%
                                    </span>
                                </p>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="info-card">
                                <h6>Piyasa Bilgileri</h6>
                                <p><strong>Piyasa Değeri:</strong><br>$${coin.market_cap.toLocaleString()}</p>
                                <p><strong>Hacim (24h):</strong><br>$${coin.total_volume.toLocaleString()}</p>
                                <p><strong>Rank:</strong><br>#${coin.market_cap_rank}</p>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="info-card">
                                <h6>Arz Bilgileri</h6>
                                <p><strong>Dolaşımda:</strong><br>${coin.circulating_supply.toLocaleString()}</p>
                                <p><strong>Toplam Arz:</strong><br>${coin.total_supply ? coin.total_supply.toLocaleString() : 'Sınırsız'}</p>
                                <p><strong>Son Güncelleme:</strong><br>${new Date(coin.last_updated).toLocaleString('tr-TR')}</p>
                            </div>
                        </div>
                    </div>
                `;
                
                // Modal içeriğini doldur
                document.getElementById('coinDetailContent').innerHTML = modalContent;
                
                // Modal'ı aç
                const modal = new bootstrap.Modal(document.getElementById('coinDetailModal'));
                modal.show();
                
            } else {
                alert('Coin bilgileri alınamadı!');
            }
        }).catch(error => {
            console.error('Hata:', error);
            alert('Coin bilgileri yüklenirken hata oluştu!');
        });
    }


</script>


<style>
    /* Temel Stiller */
    body {
        font-family: Arial, sans-serif;
        background: #6e6c6c;
        padding: 20px;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        background: rgb(255, 255, 255);
        padding: 20px;
        border-radius: 8px;
    }

    h1 {
        text-align: center;
        margin-bottom: 20px;
    }

    
    /* Tablo */
    .table-responsive {
        overflow-x: auto;
    }

    .crypto-table {
        width: 100%;
        border-collapse: collapse;
    }

        .crypto-table th,
        .crypto-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .crypto-table th {
            background: #333;
            color: white;
        }

        .crypto-table tbody tr:hover {
            background: #f5f5f5;
        }

        /* Sütun genişlikleri */
        .crypto-table th:nth-child(1),
        .crypto-table td:nth-child(1) {
            width: 10%;
            text-align: center;
        }

        .crypto-table th:nth-child(3),
        .crypto-table td:nth-child(3),
        .crypto-table th:nth-child(4),
        .crypto-table td:nth-child(4),
        .crypto-table th:nth-child(5),
        .crypto-table td:nth-child(5) {
            text-align: right;
        }

    /* Renkler */
    .positive {
        color: #4CAF50;
    }

    .negative {
        color: #f44336;
    }

    /* Buton Hizalama */
    .crypto-table button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: 10px;
        text-align: left;
    }

        .crypto-table button:hover {
            background: #f5f5f5;
        }

        /* Her span için eşit genişlik */
        .crypto-table button span {
            flex: 1;
            text-align: center;
        }

            /* İlk span (sıra numarası) daha dar */
            .crypto-table button span:first-child {
                flex: 0.5;
            }

            /* Son span (market cap) biraz daha geniş */
            .crypto-table button span:last-child {
                flex: 1.2;
            }


    {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }

    .crypto-table th,
    .crypto-table td {
        padding: 8px;
        font-size: 14px;
    }

    /* Modal için ek stiller */
    .info-card {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 15px;
        border-left: 4px solid #007bff;
    }

    .info-card h6 {
        color: #007bff;
        margin-bottom: 10px;
        font-weight: bold;
    }

    .coin-detail-header {
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 15px;
    }

    .badge {
        font-size: 0.9em;
    }

    .chart-container {
        background: #f8f9fa;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .custom-modal {
        background: white;
        border-radius: 8px;
        max-width: 600px;
        width: 90%;
        max-height: 80%;
        overflow-y: auto;
    }

    .custom-modal-header {
        padding: 20px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
    }

    .custom-modal-body {
        padding: 20px;
    }

    .custom-modal-footer {
        padding: 20px;
        border-top: 1px solid #eee;
        text-align: right;
    }
</style>