@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 4rem;"></i>
                    <h1 class="text-danger mb-3">Hata Oluştu</h1>
                    <h2 class="text-muted mb-4">İsteğiniz işlenirken bir hata meydana geldi.</h2>
                    
                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-info">
                            <strong>İstek ID:</strong> <code>@Model.RequestId</code>
                        </div>
                    }
                    
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary me-2">
                            <i class="fas fa-home me-1"></i>Ana Sayfaya Dön
                        </a>
                        <button onclick="history.back()" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Geri Dön
                        </button>
                    </div>
                </div>
            </div>
            
            @if (Model.ShowRequestId)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Geliştirici Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>Geliştirme Modu:</strong> Daha detaylı hata bilgileri için <strong>Development</strong> ortamını etkinleştirin.
                        </p>
                        <p class="mb-0">
                            <strong>Uyarı:</strong> Production ortamında Development modu etkin olmamalıdır. 
                            Hassas bilgilerin kullanıcılara gösterilmesine neden olabilir.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
